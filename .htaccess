# ==============================================================================
# APACHE / LITESPEED SECURITY HEADERS & ROUTING CONFIGURATION
# File: .htaccess
# ==============================================================================

<IfModule mod_headers.c>
    # 1. HSTS (Cưỡng bức HTTPS 2 năm kèm Preload)
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

    # 2. X-Frame-Options (Chặn Clickjacking ở cấp độ mạng)
    Header always set X-Frame-Options "DENY"

    # 3. X-Content-Type-Options (Chống MIME-sniffing)
    Header always set X-Content-Type-Options "nosniff"

    # 4. Permissions-Policy
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

    # 5. Content-Security-Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; media-src 'self' blob: https://speechgen.io https://translate.google.com https://dict.youdao.com data:; connect-src 'self' https://mazii.net https://speechgen.io https://inputtools.google.com https://www.google.com https://translate.google.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self';"

    # 6. Referrer-Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # 7. Cross-Origin-Opener-Policy
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # 8. Cross-Origin-Resource-Policy
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # 9. X-XSS-Protection
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Cưỡng bức chuyển hướng HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Bẫy Honeypot: Chặn 403 Forbidden đối với mọi truy cập /hidden-crawler-trap/
    RewriteRule ^hidden-crawler-trap(/.*)?$ - [F,L]

    # SPA Routing Fallback
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
